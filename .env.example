# Copia a .env en la raíz del proyecto (no subir .env a Git)

SECRET_KEY=cambia-esto-en-produccion

# Base de datos (Coolify / producción)
# Desarrollo local SIN túnel SSH: comenta DATABASE_URL → la app usa SQLite (art_platform.db).
# Con túnel SSH (DBeaver / prod): descomenta y deja el túnel activo en 127.0.0.1:5441
# DATABASE_URL=postgresql://linda:clave@127.0.0.1:5441/master_db

# Pasarela Stripe (opcional — sin claves se usa modo demo en checkout)
# Cuenta de prueba: https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Webhook (producción): endpoint /cliente/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Correo Gmail (restablecer contraseña en Coolify y local)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=tu@gmail.com
# MAIL_PASSWORD=contraseña-de-aplicacion-google
# MAIL_DEFAULT_SENDER=tu@gmail.com

# Coolify (app Flask — NO marcar "static site"; puerto expuesto = 3000)
# FLASK_ENV=production
# SECRET_KEY=genera-una-clave-larga
# DATABASE_URL=postgresql://linda:clave@postgres-db:5432/master_db
# No uses NIXPACKS_NODE_VERSION (eso es para proyectos Node, no Python)
